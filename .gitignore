@'
# Dependencies
node_modules/
frontend/node_modules/
server/node_modules/

# Environment variables and secrets
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
server/.env
server/.env.*
!server/.env.example

# Build output
dist/
build/
frontend/dist/
server/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Coverage and test output
coverage/

# Local tooling
.vscode/
.idea/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Local databases and backups
data/
mongodb-data/
mongo-backups/
*.bson
*.archive
'@ | Set-Content -Path .gitignore -Encoding utf8

# Claude Code local configuration
.claude/

# Development logs
.devlog.txt
frontend/.devlog.txt
server/.devlog.txt

# MongoDB data and files
*.wt
WiredTiger*
_mdb_catalog.wt
diagnostic.data/
journal/